{
  "name": "mediaforge-api",
  "main": "index.mjs",
  "account_id": "7c28cd9ef2aed1dcdea11e46b57cff99",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "services": [{ "binding": "AUTH", "service": "showtime" }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "MediaforgeAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaforgeAccount"] }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "GENERATION_LIMITER", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }
  ]
}
